{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warmly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "development",
    "FRONTEND_URL": "http://localhost:5173"
  }
}
